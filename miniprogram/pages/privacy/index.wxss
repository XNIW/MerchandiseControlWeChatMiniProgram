.policy-page { padding: 32rpx 36rpx calc(40rpx + env(safe-area-inset-bottom)); }
.language { padding: 24rpx 0; min-height: 48rpx; font-size: 30rpx; color: #0d5c46; }
.eyebrow, .title, .description, .notice, .heading, .paragraph, .version { display: block; white-space: normal; overflow-wrap: break-word; }
.eyebrow, .version { color: #425b53; font-size: 26rpx; line-height: 1.6; }
.title { margin: 20rpx 0; font-size: 48rpx; font-weight: 700; line-height: 1.35; }
.description, .paragraph { font-size: 32rpx; line-height: 1.7; margin: 20rpx 0; }
.notice { background: #fff7dc; color: #523c0b; padding: 24rpx; margin: 28rpx 0; border-radius: 12rpx; font-size: 28rpx; line-height: 1.7; }
.section { margin: 40rpx 0; }
.heading { font-size: 38rpx; font-weight: 600; line-height: 1.5; }
.version { margin: 32rpx 0; }
button { margin-top: 24rpx; font-size: 30rpx; }
