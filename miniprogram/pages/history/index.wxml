<view class="page">
  <view class="mode-tabs"><button class="{{viewMode === 'catalog' ? 'selected' : ''}}" bindtap="selectCatalog">{{text.catalogHistory}}</button><button class="{{viewMode === 'sync' ? 'selected' : ''}}" bindtap="selectSync">{{text.syncHistory}}</button></view>
  <view wx:if="{{viewMode === 'catalog' && canReadCatalogHistory}}" class="filters">
    <picker range="{{entityOptions}}" range-key="label" value="{{entityIndex}}" bindchange="chooseEntity"><view class="picker-value">{{text.filter}} · {{entityOptions[entityIndex].label}}</view></picker>
    <picker range="{{operationOptions}}" range-key="label" value="{{operationIndex}}" bindchange="chooseOperation"><view class="picker-value">{{text.operation}} · {{operationOptions[operationIndex].label}}</view></picker>
    <input class="picker-value" placeholder="{{text.entityId}}" value="{{entityId}}" bindinput="changeEntityId"/>
    <view class="date-row"><picker mode="date" value="{{fromDate}}" bindchange="chooseFromDate"><view class="picker-value">{{text.from}} · {{fromDate || text.none}}</view></picker><picker mode="date" value="{{toDate}}" bindchange="chooseToDate"><view class="picker-value">{{text.to}} · {{toDate || text.none}}</view></picker></view>
    <view class="filter-actions"><button size="mini" class="primary" bindtap="applyFilters">{{text.applyFilters}}</button><button size="mini" bindtap="clearFilters">{{text.clearFilters}}</button></view>
  </view>
  <text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text>
  <text wx:if="{{loading}}" class="muted">{{text.loading}}</text>
  <view wx:if="{{viewMode === 'catalog'}}">
    <view wx:if="{{!loading && !errorMessage && catalogItems.length === 0}}" class="empty">{{text.noHistory}}</view>
    <view class="list"><view wx:for="{{catalogItems}}" wx:key="history_id" class="history-row"><view><text class="strong">{{item.entity_label}} · {{item.operation_label}}</text><text class="muted">{{item.occurred_at}} · {{item.actor_display_name}} · {{item.surface_label}}</text><text class="muted">{{item.entity_id_redacted || text.none}} · {{item.result_label}}</text></view></view></view>
    <button wx:if="{{hasMoreCatalog}}" disabled="{{loading}}" bindtap="loadMore">{{text.loadMore}}</button>
  </view>
  <view wx:if="{{viewMode === 'sync'}}">
    <view wx:if="{{!loading && !errorMessage && syncItems.length === 0}}" class="empty">{{text.noHistory}}</view>
    <view class="list"><view wx:for="{{syncItems}}" wx:key="event_id" class="history-row"><view><text class="strong">{{item.domain}} · {{item.event_type}}</text><text class="muted">{{item.created_at}} · {{item.source || text.none}}</text></view><text>{{item.changed_count}}</text></view></view>
    <button wx:if="{{hasMoreSync}}" disabled="{{loading}}" bindtap="loadMore">{{text.loadMore}}</button>
  </view>
</view>
