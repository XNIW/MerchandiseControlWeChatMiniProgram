<view class="page">
  <view class="toolbar"><button size="mini" bindtap="previousDay">‹ {{text.previousDay}}</button><picker mode="date" value="{{anchorDate}}" bindchange="chooseDate"><view class="date-pill">{{anchorDate}}</view></picker><button size="mini" bindtap="nextDay">{{text.nextDay}} ›</button></view>
  <scroll-view scroll-x class="range-strip"><button size="mini" data-range="last_7" bindtap="selectRange">{{text.last7}}</button><button size="mini" data-range="last_30" bindtap="selectRange">{{text.last30}}</button><button size="mini" data-range="month" bindtap="selectRange">{{text.month}}</button></scroll-view>
  <view class="card"><text class="metric-title">{{text.netRevenue}}</text><text class="hero">{{net}}</text><view class="two-column"><text>{{text.grossRevenue}} · {{gross}}</text><text>{{text.refunds}} · {{refunds}}</text></view><view class="two-column"><text>{{text.saleCount}} · {{saleCount}}</text><text class="muted">{{timeZone}}</text></view></view>
  <view class="card period-days"><text class="section-title">{{text.date}}</text><view wx:for="{{days}}" wx:key="business_date" class="day-row"><view><text class="strong">{{item.business_date}}</text><text class="muted">{{text.saleCount}} · {{item.sale_count}}</text></view><view class="right"><text>{{item.currency_code}} {{item.net_revenue_clp}}</text><text class="muted">{{text.grossRevenue}} {{item.gross_sales_clp}} · {{text.refunds}} {{item.refunds_clp}}</text></view></view></view>
  <view class="filters"><input placeholder="{{text.saleNumber}}" value="{{saleNumber}}" bindinput="searchSale"/><picker range="{{kinds}}" value="{{kindIndex}}" bindchange="chooseKind"><view class="filter-pill">{{text.refunds}} · {{kinds[kindIndex] || text.all}}</view></picker></view>
  <scroll-view scroll-x class="filter-strip"><picker range="{{statuses}}" value="{{statusIndex}}" bindchange="chooseStatus"><view class="filter-pill">{{text.status}} · {{statuses[statusIndex] || text.all}}</view></picker><picker range="{{paymentMethods}}" value="{{paymentIndex}}" bindchange="choosePayment"><view class="filter-pill">{{text.payment}} · {{paymentMethods[paymentIndex] || text.all}}</view></picker><picker wx:if="{{staffOptions.length > 1}}" range="{{staffOptions}}" range-key="name" value="{{staffIndex}}" bindchange="chooseStaff"><view class="filter-pill">{{text.cashier}} · {{staffOptions[staffIndex].name}}</view></picker><picker wx:if="{{deviceOptions.length > 1}}" range="{{deviceOptions}}" range-key="name" value="{{deviceIndex}}" bindchange="chooseDevice"><view class="filter-pill">{{text.device}} · {{deviceOptions[deviceIndex].name}}</view></picker></scroll-view>
  <text wx:if="{{loading}}" class="muted">{{text.loading}}</text><text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text>
  <view wx:if="{{!loading && sales.length === 0}}" class="empty">{{text.empty}}</view>
  <view class="list"><view wx:for="{{sales}}" wx:key="pos_sale_id" class="row" data-id="{{item.pos_sale_id}}" bindtap="openDetail"><view><text class="strong">{{item.sale_number}}</text><text class="muted">{{item.occurred_at}} · {{item.staff_name || item.device_name || ''}}</text></view><view class="right"><text>{{item.currency_code}} {{item.net_amount_clp}}</text><text class="muted">{{item.business_kind}}</text></view></view></view>
  <button wx:if="{{sales.length >= 50}}" bindtap="loadMore">{{text.loadMore}}</button>
</view>
