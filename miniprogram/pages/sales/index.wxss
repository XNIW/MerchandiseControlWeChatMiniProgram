@import "../shared.wxss";
.toolbar,.two-column,.filters{align-items:center;display:flex;justify-content:space-between;gap:12rpx}.range-strip,.filter-strip{margin:16rpx 0;white-space:nowrap}.range-strip button,.filter-strip picker{display:inline-block;margin-right:12rpx}.date-pill,.filter-pill{background:#fff;border-radius:14rpx;padding:16rpx 24rpx}.filters input{background:#fff;border-radius:14rpx;padding:16rpx}.hero{display:block;font-size:48rpx;font-weight:700;margin:10rpx 0 24rpx}.metric-title,.muted{color:#648078;font-size:23rpx;display:block}.right{text-align:right}.period-days{max-height:520rpx;overflow:hidden}.day-row{align-items:center;border-top:1rpx solid #e5ece9;display:flex;justify-content:space-between;padding:18rpx 0}
