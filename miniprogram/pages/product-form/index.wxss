@import "../shared.wxss";
.form-card,.error-card{background:#fff;border-radius:22rpx;box-shadow:0 6rpx 24rpx rgba(13,92,70,.07);padding:28rpx}.field{display:block;margin-bottom:24rpx}.field>text{color:#385b51;display:block;font-size:24rpx;margin-bottom:10rpx}.field input,.picker-value{background:#f3f7f5;border:1rpx solid #d8e4df;border-radius:14rpx;min-height:48rpx;padding:18rpx 20rpx}.image-hook{border:1rpx dashed #b9ccc5;border-radius:14rpx;display:flex;flex-direction:column;gap:8rpx;margin:10rpx 0 26rpx;padding:20rpx}.save{margin-top:16rpx}.error-card button{margin-top:22rpx}
