<view class="page"><view wx:if="{{!featureReady}}" class="feature-gate"><text class="feature-gate-title">{{text.disabledTitle}}</text><text class="feature-gate-detail">{{text.disabledDetail}}</text></view><block wx:else><text wx:if="{{loading}}">{{text.loading}}</text><view wx:if="{{errorMessage}}" class="error"><text>{{errorMessage}}</text><button wx:if="{{signedIn}}" bindtap="load" disabled="{{loading}}">{{text.retry}}</button></view><view wx:if="{{!loading && account}}" class="card"><text class="section-title">{{account.display_name}}</text><text class="muted">{{account.profile_status === 'active' ? text.active : account.profile_status === 'disabled' ? text.accountDisabled : text.accountReview}}</text><view class="row"><text>{{text.provider}}</text><text>{{providersText}}</text></view><view class="row"><text>WeChat</text><text>{{(account.wechat_linked || account.mini_identity_linked) ? text.linked : text.notLinked}}</text></view></view><view wx:if="{{signedIn}}" class="card"><picker wx:if="{{shops.length}}" range="{{shops}}" range-key="shop_name" bindchange="chooseShop"><view class="row"><text>{{text.activeShop}}</text><text>{{currentShop.shop_name}} ›</text></view></picker><view wx:elif="{{currentShop}}" class="row"><text>{{text.activeShop}}</text><text>{{currentShop.shop_name}}</text></view><picker range="{{locales}}" value="{{localeIndex}}" bindchange="chooseLocale"><view class="row"><text>Language / 语言</text><text>{{locales[localeIndex]}} ›</text></view></picker><view class="row"><text>{{text.appVersion}}</text><text>0.1.0</text></view></view><button wx:if="{{signedIn}}" class="logout" bindtap="signOut">{{text.signOut}}</button></block><view wx:if="{{enrollmentReady}}" class="card" bindtap="openPairing"><text>WeChat Mini ›</text></view><view class="card"><view class="row" bindtap="openPrivacy"><text>{{text.privacy}} / {{text.deletion}}</text><text>›</text></view></view><view wx:if="{{pending.length || outboxError}}" class="card"><text class="section-title">{{text.pendingChanges}}</text><text wx:if="{{pendingShopName}}" class="muted">{{text.activeShop}} · {{pendingShopName}}</text><text>{{outboxError}}</text><view wx:for="{{pending}}" wx:key="operationId"><text>{{item.label}} · {{item.stateLabel}}</text><button wx:if="{{item.state === 'failed_terminal' && item.attempts >= 8}}" size="mini" data-id="{{item.operationId}}" bindtap="retryPending">{{text.retry}}</button><button size="mini" data-id="{{item.operationId}}" bindtap="discardPending" disabled="{{item.state === 'sending'}}">{{text.discardPending}}</button></view><view wx:if="{{outboxError}}"><button bindtap="recoverPending">{{text.retry}}</button><button bindtap="discardPending">{{text.discardPending}}</button></view></view></view>
