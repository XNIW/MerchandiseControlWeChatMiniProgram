<view class="page"><text wx:if="{{loading}}">{{text.loading}}</text><view wx:elif="{{account}}"><view class="card"><text class="section-title">{{account.display_name}}</text><text class="muted">{{account.profile_status}}</text><view class="row"><text>{{text.provider}}</text><text>{{providersText}}</text></view><view class="row"><text>WeChat</text><text>{{account.wechat_linked ? text.linked : text.notLinked}}</text></view></view><view class="card"><picker range="{{shops}}" range-key="shop_name" bindchange="chooseShop"><view class="row"><text>{{text.activeShop}}</text><text>{{currentShop.shop_name}} ›</text></view></picker><picker range="{{locales}}" value="{{localeIndex}}" bindchange="chooseLocale"><view class="row"><text>Language / 语言</text><text>{{locales[localeIndex]}} ›</text></view></picker><view class="row"><text>{{text.appVersion}}</text><text>0.1.0</text></view><view class="row" bindtap="openPrivacy"><text>{{text.privacy}} / {{text.deletion}}</text><text>›</text></view></view><button class="logout" bindtap="signOut">{{text.signOut}}</button></view></view>
