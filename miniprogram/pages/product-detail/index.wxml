<view class="page">
  <text wx:if="{{loading}}" class="muted">{{text.loading}}</text>
  <text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text>
  <button wx:if="{{imagePermissionDenied}}" open-type="openSetting">{{text.openPermissions}}</button>
  <view wx:if="{{imagePreviewUrl}}" class="image-preview">
    <text class="section-title">{{text.imagePreview}}</text>
    <image class="hero-image" src="{{imagePreviewUrl}}" mode="aspectFit"/>
    <image class="preview-thumb" src="{{imagePreviewThumb}}" mode="aspectFit"/>
    <view class="action-row"><button bindtap="cancelImagePreview">{{text.cancel}}</button><button class="primary" bindtap="confirmImagePreview">{{text.useImage}}</button></view>
  </view>
  <view wx:if="{{!loading && product}}">
    <image wx:if="{{imageUrl}}" class="hero-image" src="{{imageUrl}}" mode="aspectFit" lazy-load data-version="{{product.primary_image_version_id}}" data-url="{{imageUrl}}" binderror="imageFailed"/>
    <view wx:else class="hero-placeholder">{{text.imageUnavailable}}</view>
    <view wx:if="{{canManageImages}}" class="action-row">
      <button size="mini" loading="{{imageBusy}}" disabled="{{imageBusy}}" data-source="camera" bindtap="replaceImage">{{text.camera}}</button>
      <button size="mini" disabled="{{imageBusy}}" data-source="album" bindtap="replaceImage">{{text.gallery}}</button>
      <button wx:if="{{product.primary_image_version_id}}" size="mini" disabled="{{imageBusy}}" bindtap="removeImage">{{text.removeImage}}</button>
    </view>
    <text wx:if="{{!canEdit}}" class="read-only">{{text.readOnlyCatalog}}</text>
    <view class="card">
      <text class="section-title">{{product.product_name || product.second_product_name || product.barcode}}</text>
      <view class="row"><text>{{text.barcode}}</text><text>{{product.barcode}}</text></view>
      <view class="row"><text>{{text.itemNumber}}</text><text>{{product.item_number || text.none}}</text></view>
      <view class="row"><text>{{text.category}}</text><text>{{product.category_name || text.none}}</text></view>
      <view class="row"><text>{{text.supplier}}</text><text>{{product.supplier_name || text.none}}</text></view>
      <view class="row"><text>{{text.retailPrice}} · {{currencyCode}}</text><text>{{product.retail_price === null ? text.none : retailPriceText}}</text></view>
      <view class="row"><text>{{text.stock}}</text><text>{{product.stock_quantity === null ? text.none : stockText}}</text></view>
      <text class="muted">{{text.updated}} · {{product.updated_at}}</text>
    </view>
    <view wx:if="{{canEdit}}" class="action-row">
      <button class="primary" disabled="{{mutating}}" bindtap="edit">{{text.edit}}</button>
      <button class="danger" loading="{{mutating}}" disabled="{{mutating}}" bindtap="archive">{{text.archive}}</button>
    </view>
    <text class="section-title">{{text.priceHistory}}</text>
    <text wx:if="{{pricesError}}" class="error">{{pricesError}}</text>
    <button wx:if="{{pricesMore}}" loading="{{pricesLoading}}" disabled="{{pricesLoading}}" bindtap="loadMorePrices">{{pricesError ? text.retry : text.loadMore}}</button>
    <text wx:else class="muted">{{text.endOfList}}</text>
    <view wx:if="{{prices.length === 0 && !pricesLoading && !pricesError}}" class="empty">{{text.noHistory}}</view>
    <view class="list"><view wx:for="{{prices}}" wx:key="price_id" class="row"><view><text class="strong">{{item.price_type_label}}</text><text class="muted">{{item.effective_at}} · {{item.source || text.none}}</text></view><text>{{item.price_text}} {{currencyCode}}</text></view></view>
  </view>
  <view wx:if="{{!loading && !product && !errorMessage}}" class="empty">{{text.empty}}</view>
</view>
