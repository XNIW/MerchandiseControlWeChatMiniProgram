@import "../shared.wxss";
.image-preview{background:#fff;border:2rpx solid #087f67;border-radius:22rpx;margin-bottom:22rpx;padding:20rpx}.preview-thumb{height:120rpx;width:120rpx}
.hero-image,.hero-placeholder{background:#fff;border-radius:22rpx;height:520rpx;margin-bottom:22rpx;width:100%}.hero-placeholder{align-items:center;color:#648078;display:flex;justify-content:center}
.action-row{display:flex;gap:16rpx;margin:18rpx 0}.action-row button{flex:1}.danger{background:#fff0ef;color:#9b1c16}.read-only{background:#eef5f2;border-radius:14rpx;color:#42675c;display:block;margin:16rpx 0;padding:18rpx}

.card .row{align-items:flex-start;gap:16rpx}.card .row>text{min-width:0;word-break:break-all}.card .row>text:first-child{flex:0 0 34%}.card .row>text:last-child{flex:1;text-align:right}.section-title{word-break:break-all}
.action-row{flex-wrap:wrap}.action-row button{flex:1 1 180rpx;line-height:1.5;min-width:0;padding:16rpx;white-space:normal}
