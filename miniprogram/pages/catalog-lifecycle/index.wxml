<view class="page">
  <text wx:if="{{!canRestore}}" class="read-only">{{text.readOnlyCatalog}}</text>
  <text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text>
  <text wx:if="{{loading && items.length === 0}}" class="muted">{{text.loading}}</text>
  <view wx:if="{{!loading && !errorMessage && items.length === 0}}" class="empty">{{text.empty}}</view>
  <view class="list"><view wx:for="{{items}}" wx:key="entity_id" class="entity-row"><view class="entity-copy"><text class="strong">{{item.display_name}}</text><text wx:if="{{item.barcode}}" class="muted">{{text.barcode}} · {{item.barcode}}</text><text class="muted">{{item.state_label}} · {{text.updated}} · {{item.updated_at}}</text><text wx:if="{{entityType !== 'product'}}" class="muted">{{text.productCount}} · {{item.active_product_count}}</text></view><button wx:if="{{canRestore}}" size="mini" data-id="{{item.entity_id}}" loading="{{restoringId === item.entity_id}}" disabled="{{!!restoringId}}" bindtap="restore">{{text.restore}}</button></view></view>
  <button wx:if="{{hasMore}}" loading="{{loading}}" disabled="{{loading}}" bindtap="loadMore">{{text.loadMore}}</button>
</view>
