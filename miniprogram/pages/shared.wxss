.page{padding:28rpx}.card,.list,.empty{background:#fff;border-radius:22rpx;box-shadow:0 6rpx 24rpx rgba(13,92,70,.07);margin-bottom:22rpx;padding:28rpx}.row{align-items:center;border-bottom:1rpx solid #e6eeeb;display:flex;justify-content:space-between;padding:24rpx 0}.row:last-child{border-bottom:0}.strong{display:block;font-size:29rpx;font-weight:650}.muted{color:#648078;font-size:23rpx}.error{color:#b3261e}.empty{text-align:center}.section-title{display:block;font-size:34rpx;font-weight:680;margin:26rpx 0 16rpx}.search{background:#fff;border-radius:16rpx;margin-bottom:18rpx;padding:18rpx 24rpx}
