<view class="page"><text wx:if="{{loading}}">{{text.loading}}</text><view wx:elif="{{detail}}"><view class="card"><text class="section-title">{{detail.sale.sale_number}}</text><text>{{detail.sale.occurred_at}}</text><text class="muted">{{detail.sale.staff_name || ''}} · {{detail.sale.device_name || ''}}</text><view class="row"><text>{{text.grossRevenue}}</text><text>{{detail.sale.currency_code}} {{grossText}}</text></view><view class="row"><text>{{text.discount}}</text><text>{{detail.sale.currency_code}} {{discountText}}</text></view><view class="row"><text>{{text.netRevenue}}</text><text>{{detail.sale.currency_code}} {{netText}}</text></view><text class="muted">{{detail.sale.business_kind}} · {{detail.sale.sale_status}} · {{detail.sale.fiscal_status}}</text></view><text class="section-title">{{text.products}}</text><view class="list"><view wx:for="{{lines}}" wx:key="line_position" class="row"><view><text class="strong">{{item.product_name || item.barcode}}</text><text class="muted">{{item.quantityText}} × {{item.unitText}}</text></view><text>{{item.amountText}}</text></view></view></view><view wx:else class="empty">{{errorMessage || text.empty}}</view></view>
