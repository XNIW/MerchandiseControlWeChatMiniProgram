<view class="page"><text wx:if="{{loading}}">{{text.loading}}</text><view wx:elif="{{detail}}"><view class="card"><text class="section-title">{{detail.sale.sale_number}}</text><text>{{detail.sale.occurred_at}}</text><text class="muted">{{detail.sale.staff_name || ''}} · {{detail.sale.device_name || ''}}</text><view class="row"><text>{{text.grossRevenue}}</text><text>{{detail.sale.currency_code}} {{detail.sale.gross_amount_clp}}</text></view><view class="row"><text>{{text.refunds}}</text><text>{{detail.sale.currency_code}} {{detail.sale.discount_amount_clp}}</text></view><view class="row"><text>{{text.netRevenue}}</text><text>{{detail.sale.currency_code}} {{detail.sale.net_amount_clp}}</text></view><text class="muted">{{detail.sale.business_kind}} · {{detail.sale.sale_status}} · {{detail.sale.fiscal_status}}</text></view><text class="section-title">{{text.products}}</text><view class="list"><view wx:for="{{detail.lines}}" wx:key="line_position" class="row"><view><text class="strong">{{item.product_name || item.barcode}}</text><text class="muted">{{item.quantity}} × {{item.unit_amount_clp}}</text></view><text>{{item.line_amount_clp}}</text></view></view></view><view wx:else class="empty">{{errorMessage || text.empty}}</view></view>
